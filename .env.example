# Copie para .env (desenvolvimento local) ou cadastre cada linha nas variáveis de
# ambiente da hospedagem (produção). NUNCA coloque valores reais neste arquivo:
# ele é versionado. O arquivo .env real está no .gitignore.

# --- Essenciais -------------------------------------------------------------
# Chave que assina os cookies de sessão. Gere: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Em produção, MASTER_PASSWORD_HASH é obrigatório. MASTER_PASSWORD não é usado para autenticação.
# Hash da senha mestre (recomendado). Gere:
# python -c "import getpass;from werkzeug.security import generate_password_hash as g;print(g(getpass.getpass()))"
# Ao exportar no shell, use aspas simples (o hash contém $).
# Em Render, use a variável MASTER_PASSWORD_HASH (o Blueprint solicita o valor).
MASTER_PASSWORD_HASH=

# --- Provedores de IA (todos opcionais) --------------------------------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=
GITHUB_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Outros serviços (opcionais) ---------------------------------------------
HIBP_API_KEY=
NETLIFY_AUTH_TOKEN=

# --- Rede e segurança ---------------------------------------------------------
# Nº de proxies confiáveis na frente do app (0 = nenhum; 1 = PaaS comum; 2 = Cloudflare + PaaS)
TRUSTED_PROXY_HOPS=
# Hosts aceitos, separados por vírgula (vazio = qualquer). Ex.: meusite.com,www.meusite.com
ALLOWED_HOSTS=
SESSION_HOURS=12
# Timeout por inatividade em minutos (0 = desligado). Produção recomenda 30.
SESSION_IDLE_MINUTES=30
ACCESS_LOG_RETENTION_DAYS=90
SECURITY_BACKUP_RETENTION=10
# 0 desliga o sandbox do preview de sites (libera localStorage no preview; menos seguro)
PREVIEW_SANDBOX=1
FLASK_DEBUG=0

# WebAuthn / Passkey — permaneça desativado até os testes criptográficos passarem
WEBAUTHN_ENABLED=false
# Em produção, configure exatamente o host do serviço e a origin HTTPS.
# Ex.: WEBAUTHN_RP_ID=jarvis.example.com
# Ex.: WEBAUTHN_ORIGIN=https://jarvis.example.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=JARVIS Cyber Platform
